# Application Configuration
APP_NAME=ai-devops-monitor
APP_PORT=5000
APP_ENV=production
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Grafana Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_secure_password_replace_me

# Prometheus Configuration
PROMETHEUS_PORT=9090

# AI Log Analyzer Configuration
AI_ANALYZER_INTERVAL_SECONDS=60
# Optional: Set your Gemini API key to enable generative AI root-cause analysis
# If left blank, the analyzer uses the robust built-in rule-based expert engine
GEMINI_API_KEY=

# Auto-Healing Configuration
MAX_RESTART_ATTEMPTS=3
COOLDOWN_SECONDS=60
CONTAINER_NAME=flask-app
HEALTH_CHECK_URL=http://localhost:5000/health

# AWS & Jenkins CI/CD Configuration (Used in Jenkins Credentials Manager)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_NAME=ai-devops-monitoring
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
EC2_USER=ubuntu
